    },
    "Saved forms keep your entries and markup. Reusable templates keep a filled-in starting point for new forms." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los formularios guardados conservan los datos y las anotaciones. Las plantillas reutilizables conservan los datos ya completados como punto de partida para nuevos formularios."
          }
        }
      }
